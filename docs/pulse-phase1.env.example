# Required on the API service before deploying Phase 1. No production fallback.
NODE_ENV=production
# Generate independently (e.g. node crypto.randomBytes(48).toString('base64')).
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# Enable only the external provider actually used by the frontend.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# For legacy HS256 Supabase signing only; not needed for ES256/RS256 JWKS.
SUPABASE_JWT_SECRET=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
# Independent random 32-byte base64 key. Retain securely with DB backups.
MARKETING_ENCRYPTION_KEY=
# Leave disabled. Apply reviewed migrations explicitly before deployment.
RUN_LEGACY_SCHEMA_UPGRADER=false
