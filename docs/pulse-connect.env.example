# Disabled until the reviewed migration, frontend and OAuth client are ready.
PULSE_CONNECT_ENABLED=false
# Existing domains verified during the audit; no new domain or DNS is needed.
PULSE_CONNECT_ORIGIN=https://api.crm.o7digitalgroup.com
PULSE_CONNECT_FRONTEND=https://crm.o7digitalgroup.com
# Public OAuth client identifier. Set this same value in ChatGPT.
PULSE_CONNECT_CLIENT_ID=pulse-chatgpt
# Copy the exact callback shown by ChatGPT; comma-separated, exact-match allowlist.
# Leave empty until it is available. Never use a wildcard callback.
PULSE_CONNECT_REDIRECT_URIS=
# Keep all current DATABASE_URL/JWT_* settings. No shared CRM API key is used.
