DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
JWT_SECRET=change-me
PORT=4000
FRONTEND_URL=http://localhost:3000
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Private ChatGPT / external AI integration (API/Railway only)
# Generate a long random secret. Never expose it through NEXT_PUBLIC_* variables.
CHATGPT_API_KEY=replace-with-at-least-32-random-bytes
CHATGPT_O7_TENANT_ID=replace-with-o7-tenant-uuid
# Emergency kill switch. Set to false to reject every integration request immediately.
CHATGPT_INTEGRATION_ENABLED=true

# Hugging Face Inference (used by /ia/* endpoints)
# Create a token on https://huggingface.co/settings/tokens
HF_API_KEY=hf_xxx
# Alternatively:
# HF_TOKEN=hf_xxx

# Optional tuning
# HF_TIMEOUT_MS=20000
# HF_INSTRUCT_MODEL=HuggingFaceTB/SmolLM3-3B
# HF_WAIT_FOR_MODEL=false
# HF_BASE_URL=https://router.huggingface.co/hf-inference/models
# Legacy aliases also accepted: HF_INFERENCE_BASE_URL, HF_API_URL, HF_INFERENCE_URL
# IA_FAIL_HARD=true  # only honored outside production

# Olivia One server-to-server opportunity integration (POST /api/integrations/olivia/opportunities)
# Shared secret checked against the X-O7-Integration-Secret header.
OLIVIA_INTEGRATION_SECRET=change-me
# JSON map of authenticated mailbox -> tenantId, resolved server-side only.
# OLIVIA_MAILBOX_TENANT_MAP={"sales@brand.com":"tenant-id"}
# JSON map of mailbox domain -> tenantId, used when no mailbox-specific mapping matches.
# OLIVIA_DOMAIN_TENANT_MAP={"brand.com":"tenant-id"}
# Optional fallback tenantId when no mailbox/domain mapping matches.
# OLIVIA_DEFAULT_TENANT_ID=tenant-id
